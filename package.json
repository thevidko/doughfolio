{
  "name": "doughfolio",
  "version": "0.1.0",
  "description": "Self-hosted, open-source crypto portfolio tracker with a cute dumpling mascot 🥟",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun test",
    "feature": "bash scripts/git/feature.sh",
    "save": "bash scripts/git/save.sh",
    "finish": "bash scripts/git/finish.sh",
    "release": "bash scripts/git/release.sh"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "bun-plugin-tailwind": "^0.0.15",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}

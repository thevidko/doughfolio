{
  "name": "doughfolio",
  "version": "0.7.1",
  "description": "Self-hosted, open-source crypto portfolio tracker with a cute dumpling mascot 🥟",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "[ -d .git ] && git config core.hooksPath scripts/git/hooks || true",
    "dev": "bun --hot src/server/index.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun test",
    "feature": "bash scripts/git/feature.sh",
    "save": "bash scripts/git/save.sh",
    "finish": "bash scripts/git/finish.sh",
    "release": "bash scripts/git/release.sh"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.3.6",
    "lightweight-charts": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "bun-plugin-tailwind": "^0.0.15",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}

# DoughFolio configuration — copy to .env and adjust.
# Every variable used by the app must be documented here.
# Env vars are infrastructure-only; user preferences live in the app settings
# (see docs/PLANNING.md #18).

# Port the server listens on (default: 3000)
PORT=3000

# Directory holding all persistent state — the SQLite database and automatic
# pre-upgrade backups (default: ./data; the Docker image sets /data)
DATA_DIR=./data
